# Discord operator interface
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PREFIX=!cove

# Local inference. Install Ollama separately and pull a model you can run locally.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# VoughtGPT / V-SID
VOUGHTGPT_BASE_URL=https://vought-signal-intelligence.vercel.app
VSID_INGEST_SECRET=

# Authorized Notion integration shared only with the pages Cove may read.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28
NOTION_RESULT_LIMIT=6
MAX_CONTEXT_CHARS=12000

# Local bridge control plane
PORT=8787
COVE_BRIDGE_SECRET=replace-with-a-long-random-secret
